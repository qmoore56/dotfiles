@import "/usr/share/rofi/themes/dmenu.rasi"

* {
    font: "Times New Roman 10";
}

window {
    height:   28px;
    padding:  0px;
    border:   0px;
    y-offset: -28px;
}

horibox {
    padding:  0px 6px;
    spacing:  6px;
    children: [ entry, listview ];
}

entry, element, element-text {
    vertical-align: 0.5;
}

element {
    padding: 0px 4px;
    border:  1px;
    border-color: transparent;
    border-radius: 4px;
}

element selected {
    background-color: #660066;
    text-color:       Black;
    border-color:     #919191;
}
